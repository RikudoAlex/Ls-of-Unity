<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; justify-content: center; align-self: center; width: 200%;">
        <ui:VisualElement name="VisualElement" style="flex-grow: initial; width: 634px; height: 850px; background-color: rgb(118, 0, 0); align-items: center; left: auto; justify-content: space-evenly; align-self: center; align-content: auto; background-image: none;">
            <ui:Label text="Βοήθεια - Οθόνη Καταγραφής Θεραπείας" name="Label" style="align-items: stretch; align-self: auto; -unity-text-align: upper-center; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/OpenSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=9f0ecda3a8c5fed44aeb7ef698b5039f&amp;type=3#OpenSans-VariableFont_wdth,wght&quot;); height: 50px; width: 117px; position: absolute; top: 3px; left: 247px; font-size: 25px; color: rgb(255, 255, 255); -unity-text-outline-width: 1.5px; justify-content: flex-start;"/>
            <ui:Label text="Η τρίτη οθόνη της ταμπλέτας αφορά στο Treatment Plan, όπου σημειώνεται στοιχεία ενδιαφέροντος για τον ασθένη και δρομολογουμένες ενέργειας, καθώς και το Medical Log (Ιατρική Καταγραφή) που κατ&apos;ουσίαν θα αναγράφει τις ενέργειες που ακολοθήσατε στα σεναρία (βλ. 4η οθόνη)." style="align-items: stretch; align-self: auto; -unity-text-align: upper-left; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/OpenSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=9f0ecda3a8c5fed44aeb7ef698b5039f&amp;type=3#OpenSans-VariableFont_wdth,wght&quot;); height: 55px; width: 607px; position: absolute; top: 52px; left: 0; font-size: 25px; color: rgb(255, 255, 255); -unity-text-outline-width: 1.5px; white-space: normal; text-overflow: clip;"/>
            <ui:Label text="Από εδώ μπορείτε να επιστρέψετε ή στα γραφήματα ή στην εκτέλεση/φόρτωση σεναρίων προσομοίωσης." name="Label" style="align-items: stretch; align-self: auto; -unity-text-align: upper-left; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/OpenSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=9f0ecda3a8c5fed44aeb7ef698b5039f&amp;type=3#OpenSans-VariableFont_wdth,wght&quot;); height: 55px; width: 607px; position: absolute; top: 713px; left: 16px; font-size: 27px; color: rgb(255, 255, 255); -unity-text-outline-width: 1.5px; white-space: normal; text-overflow: clip;"/>
